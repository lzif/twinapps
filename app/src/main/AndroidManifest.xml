<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TwinApps">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- One launcher entry per side; ProfileLauncherSetup enables the
             right one. The work alias starts disabled so a fresh install on
             the parent shows a single icon. -->
        <activity-alias
            android:name=".LauncherPersonal"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherWork"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Drives the managed-profile setup flow. -->
        <activity
            android:name=".provisioning.ProvisioningActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.PROVISION_MANAGED_PROFILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Detects manual (adb) provisioning. -->
        <receiver
            android:name=".provisioning.ManualProvisioningReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_INITIALIZE" />
            </intent-filter>
        </receiver>

        <!-- Required for managed-profile provisioning via DevicePolicyManager. -->
        <receiver
            android:name=".admin.TwinAppsDeviceAdmin"
            android:exported="false"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- M2: install session status callbacks (explicit PendingIntent delivery). -->
        <receiver
            android:name=".clone.InstallStatusReceiver"
            android:exported="false" />

        <!-- M5: file staging for cross-profile shares. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.github.lzif.twinapps.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- M5: cross-profile closure RPC endpoint. -->
        <provider
            android:name=".sharing.ShuttleProvider"
            android:authorities="io.github.lzif.twinapps.shuttle"
            android:exported="true" />

        <!-- M5: cross-profile intent ferry. -->
        <activity
            android:name=".sharing.ShuttleCarrierActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- M5: receives shares from the other profile. -->
        <activity
            android:name=".sharing.ReceiveSharedActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
